events {
  worker_connections 1024;
}

http {
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

  limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
  limit_req_status 429;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  upstream backend {
    server backend:8000 max_fails=3 fail_timeout=30s;
  }
  upstream chat_ws {
    server chat-ws:8081;
  }
  upstream frontend {
    server frontend:8080;
  }

  server {
    listen 80;
    server_name linkup.itamarabir.com;

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name linkup.itamarabir.com;

    ssl_certificate /etc/letsencrypt/live/linkup.itamarabir.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linkup.itamarabir.com/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(self)" always;
    # CSP: enforcing; report-uri value from backend/.env → SENTRY_REPORT_URI (scripts/ops/render-nginx-conf.sh or CI deploy envsubst '${SENTRY_REPORT_URI}')
    add_header Content-Security-Policy "
      default-src 'self';
      script-src 'self' https://www.gstatic.com https://*.googleapis.com https://browser.sentry-cdn.com https://www.googletagmanager.com https://accounts.google.com;
      worker-src 'self' blob:;
      style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com;
      font-src 'self' https://fonts.gstatic.com;
      img-src 'self' data: blob: https://*.googleusercontent.com https://*.amazonaws.com https://maps.gstatic.com https://*.googleapis.com;
      connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://*.sentry.io wss://linkup.itamarabir.com https://www.google-analytics.com https://firebase.googleapis.com https://firebaseapp.com https://linkup-uploads.s3.amazonaws.com https://maps.googleapis.com;
      frame-src https://js.stripe.com https://accounts.google.com;
      frame-ancestors 'none';
      base-uri 'self';
      form-action 'self' https://checkout.stripe.com;
      report-uri ${SENTRY_REPORT_URI};
    " always;

    # Liveness probe — public. Innocuous payload, safe for external uptime
    # monitors (UptimeRobot etc.). Probes live at root (not /api/v1/) on
    # purpose: they are infra signals, decoupled from API versioning.
    location = /livez {
      proxy_pass http://backend;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Readiness probe — internal only. /readyz exposes the internal infra
    # topology (DB / Redis / RabbitMQ / circuit-breaker state); public
    # exposure is free reconnaissance for attackers. Operators read it from
    # the EC2 host (curl -k https://localhost/readyz) or via
    # `docker exec linkup_backend python -c "..."`.
    location = /readyz {
      allow 127.0.0.1;
      allow ::1;
      deny all;

      proxy_pass http://backend;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # REST + WebSocket (FastAPI) — /api/v1/*
    location /api/v1/ {
      limit_req zone=api burst=50 nodelay;
      proxy_pass http://backend;
      proxy_next_upstream error timeout http_502;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 3600s;
    }

    # WebSocket → Go chat-ws
    location /ws {
      proxy_pass http://chat_ws;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_read_timeout 3600s;
    }

    # HTTP presence → Go chat-ws
    location /presence/ {
      proxy_pass http://chat_ws;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend (static)
    location / {
      proxy_pass http://frontend;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
