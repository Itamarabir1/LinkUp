# =============================================================================
# LinkUp Backend – משתני סביבה (דוגמה)
# =============================================================================
# העתק לקובץ .env ומלא ערכים אמיתיים. אל תעלה .env ל-Git.
# מקור אמת: כל המפתחות והסודות מוגדרים כאן; הפרונט מקבל מפתחות נדרשים דרך API
# (למשל מפתח Google Maps – GET /api/v1/geo/maps-key).
# =============================================================================

# --- כללי ---
PROJECT_NAME=LinkUp
APP_NAME=linkup-backend
DEBUG=False
API_DOCS_ENABLED=false

# --- Sentry (אופציונלי; השאר ריק כדי להשבית) ---
SENTRY_DSN=
# CSP violation reports מהדפדפן דרך Nginx (לא אותו מפתח כמו SENTRY_DSN). Copy מ-Security report endpoint בפרויקט Sentry → scripts/ops/render-nginx-conf.sh + CI deploy משתמשים בערך מהקובץ הזה.
SENTRY_REPORT_URI=
ENVIRONMENT=development

# --- Logging ---
# LOG_LEVEL=DEBUG | INFO | WARNING | ERROR
# json (פרודקשן) | text (פיתוח לוקאלי — קריא בטרמינל)
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- אבטחה (חובה בפרודקשן) ---
# SECRET_KEY = מפתח לחתימת JWT. חייב להיות זהה ל-JWT_SECRET ב-chat-ws (.env) – אחרת אימות ב-WebSocket נשבר.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=linkup_app
# סיסמת pgbouncer_admin — נכלל ב-infrastructure/pgbouncer/userlist.txt שנוצר ב-deploy מ-template (להתאמה ל-root .env).
PGBOUNCER_ADMIN_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- DB Connection Pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Reduced: PgBouncer handles connection multiplexing
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Uvicorn (Docker: backend/entrypoint.sh — --workers מ-UVICORN_WORKERS, ברירת מחדל 1)
UVICORN_WORKERS=4

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CHAT_DB=1

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Kafka ---

# --- פרונט וכתובות ---
FRONTEND_URL=https://linkup.co.il
API_PUBLIC_URL=

# --- Brevo (דוא"ל) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LinkUp
# React Email service (Docker Compose default hostname)
EMAIL_RENDERER_URL=http://email-renderer:3001

# --- Firebase ---
# Production (Model B): set FIREBASE_CREDENTIALS_JSON as a single-line JSON string.
# Local dev only: use FIREBASE_SERVICE_ACCOUNT_PATH to a local file.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=

# CloudFront CDN domain for avatar/media URLs (optional, falls back to presigned S3)
CLOUDFRONT_DOMAIN=

# --- EIA (מחירי דלק) ---
EIA_API_KEY=

# --- Groq (AI) — סיכום צ'אט אחרי סיום שיחה + פרסור חיפוש נסיעה בטקסט חופשי ---
# מפתח: https://console.groq.com/keys — הגדר רק ב-backend/.env (מקומי/סוד בפריסה), לא ב-Git.
# הקוד ב-app/domain/chat/ai/client.py קורא ל-GROQ_API_KEY או ל-GROK_API_KEY (מספיק אחד).
GROQ_API_KEY=
GROK_API_KEY=

# --- Google Maps (מקור אמת יחיד למפתח) ---
# משמש: Geocoding, Directions, Distance Matrix בבקאנד.
# הפרונט מקבל את המפתח אוטומטית דרך GET /api/v1/geo/maps-key (תצוגת מפה).
# אין צורך להגדיר מפתח נפרד בפרונט.
GOOGLE_MAPS_API_KEY=

# --- Google OAuth Sign-In ---
# מקור אמת: backend/docs/GOOGLE_OAUTH.md (אותו Client ID ב-frontend; ב-Console: origins + redirect URIs בלי כפילויות)
GOOGLE_CLIENT_ID=

# --- Feature Flags ---
# USER_EVENTS_ENABLED: שליחת אירועי משתמש דרך Redis → chat-ws → WebSocket
USER_EVENTS_ENABLED=True

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
