# Local Development Override — copy to docker-compose.override.yml (gitignored)
# frontend + nginx רק עם --profile prod. בפיתוח: Vite על המחשב.
services:
  nginx:
    profiles: ["prod"]
  frontend:
    profiles: ["prod"]
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: linkup_frontend
    restart: unless-stopped
    networks:
      - linkup_network
