# WARNING: passwords here must match backend/.env exactly. backend/.env is the single source of truth.
# =============================================================================
# LinkUp Root – משתני סביבה לDocker Compose
# =============================================================================
# קובץ זה משמש את docker-compose בעת הרצה בלי --env-file backend/.env.
# מומלץ: make up (משתמש ב-backend/.env). אם משתמשים בשורש .env, הסיסמאות חייבות להיות זהות.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=linkup_app

# --- Redis ---
REDIS_PASSWORD=password123

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
