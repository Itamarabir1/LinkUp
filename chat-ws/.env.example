# =============================================================================
# LinkUp Chat-WS – משתני סביבה (דוגמה)
# =============================================================================
# העתק: cp .env.example .env
# JWT_SECRET חייב להיות זהה ל-SECRET_KEY ב-backend/.env
# REDIS_URL: הסיסמה חייבת להתאים ל-REDIS_PASSWORD ב-.env בשורש וב-backend/.env
# =============================================================================

PORT=8081

JWT_SECRET=your_jwt_secret_here

# דוקר: host=redis, DB 1 (צ'אט). חייב להתאים ל-REDIS_PASSWORD ב-backend/.env
# דוגמה: אם REDIS_PASSWORD=password123 אז:
REDIS_URL=redis://:password123@redis:6379/1

# דוקר: שם השירות; ריצה מקומית (go run): http://localhost:8000
BACKEND_URL=http://backend:8000

# אופציונלי: רשימת מקורות מופרדת בפסיקים ל-CORS + WebSocket CheckOrigin (ריק = כל המקורות, נוח לפיתוח)
# ALLOWED_ORIGINS=https://linkup.co.il,http://localhost:5173
