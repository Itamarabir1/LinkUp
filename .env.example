# =============================================================================
# .env — שורש הפרויקט (דוגמה)
# משמש את docker-compose.yml בלבד
# =============================================================================
# העתק: cp .env.example .env
# הסיסמות כאן חייבות להתאים ל-backend/.env (POSTGRES_*, REDIS_PASSWORD, RABBITMQ_*).
# אל תעלה .env ל-Git.
# =============================================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linkup_app
REDIS_PASSWORD=changeme
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
LOG_LEVEL=INFO
LOG_FORMAT=json
