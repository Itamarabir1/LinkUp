# =============================================================================
# .env — שורש הפרויקט (דוגמה)
# העתק: cp .env.example .env
# משמש את docker-compose.yml בלבד (Postgres, Redis, RabbitMQ bootstrap).
# הסיסמות כאן חייבות להתאים ל-backend/.env (POSTGRES_*, REDIS_PASSWORD, RABBITMQ_*).
# אל תעלה .env ל-Git.
# =============================================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linkup_app
REDIS_PASSWORD=changeme
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
