# =============================================================================
# .env — שורש הפרויקט (דוגמה)
# משמש את docker-compose.yml בלבד
# =============================================================================
# העתק: cp .env.example .env
# הסיסמות כאן חייבות להתאים ל-backend/.env (POSTGRES_*, REDIS_PASSWORD, RABBITMQ_*, וכן PGBOUNCER_ADMIN_PASSWORD למטה).
# חשוב: pgbouncer healthcheck מסתמך על POSTGRES_USER/POSTGRES_DB/POSTGRES_PASSWORD מהקובץ הזה בזמן runtime.
# אל תעלה .env ל-Git.
# =============================================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linkup_app
REDIS_PASSWORD=changeme
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# סיסמת admin של PgBouncer (משתמש pgbouncer_admin ב-userlist) — חייבת להתאים ל-backend/.env (מקור האמת לייצוג userlist ב-deploy).
PGBOUNCER_ADMIN_PASSWORD=
# CSP report-uri לאכיפת брауз דרך Nginx בפרופיל prod: URL מלא מ-Sentry (Security headers → CSP ingestion). משמש עם scripts/ops/render-nginx-conf.sh וב-deploy על EC2.
SENTRY_REPORT_URI=
LOG_LEVEL=INFO
LOG_FORMAT=json
