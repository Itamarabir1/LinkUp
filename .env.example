# =============================================================================
# Root-level env (OPTIONAL overrides for docker compose interpolation only)
# =============================================================================
#
# SINGLE SOURCE OF TRUTH FOR PASSWORDS AND DB/REDIS/RABBITMQ CREDENTIALS:
#   backend/.env
#
# Do NOT duplicate POSTGRES_PASSWORD, REDIS_PASSWORD, RABBITMQ_* here.
# Always run Compose with:
#   docker compose --env-file backend/.env <command>
# or: make up | make down | make restart | make logs
#
# Copy backend: cp backend/.env.example backend/.env  (then fill secrets there)
#
# Optional non-secret Compose vars (Compose also reads these from backend/.env
# if you only use backend/.env; this file exists for rare root-only overrides).
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_REPORT_URI=
