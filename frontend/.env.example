# =============================================================================
# LinkUp Frontend – משתני סביבה (דוגמה)
# =============================================================================
# העתק לקובץ .env ומלא ערכים. אל תעלה .env ל-Git.
# מפתחות סודיים: מקור האמת הוא הבקאנד; הפרונט מקבל מפתחות דרך API (למשל Maps).
# =============================================================================

# --- Sentry (אופציונלי; השאר ריק כדי להשבית) ---
VITE_SENTRY_DSN=

# REST API: תמיד `/api/v1` (אותו origin; Vite proxy בפיתוח, Nginx בפרודקשן).
# Presence HTTP: אותו origin, נתיב `/presence/...` (ראה chatWsApi ב-client.ts).

# timeout לבקשות API (מילישניות). ברירת מחדל 30000 (30 שניות)
# VITE_API_TIMEOUT_MS=30000

# --- אופציונלי: מפתח Google Maps לתצוגת מפה ---
# ברירת מחדל: הפרונט מקבל את המפתח מהבקאנד (GET /api/v1/geo/maps-key).
# הגדר כאן רק אם אתה בונה ללא בקאנד או רוצה override. מקור האמת: backend/.env → GOOGLE_MAPS_API_KEY
# VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here

# --- Google OAuth Sign-In ---
# מקור אמת: backend/docs/GOOGLE_OAUTH.md (אותו Client ID כמו ב-backend; ב-Console: origins + redirect URIs בלי כפילויות)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Stripe (optional, for client-side checkout integrations) ---
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Firebase (Web) — FCM + Analytics ---
# חובה: מלא את כל הערכים ב-.env (מפתחות מ-Firebase Console → Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
